---
import Layout from '../layouts/Layout.astro';
import Chart from 'chart.js/auto';
---

<Layout>


<div class="main-container">
  <div class="dashboard">
    <aside class="sidebar">
      <h2>Dashboard</h2>
      <nav>
        <ul>
          <li class="active"><a href="#" data-section="overview">Resumen</a></li>
          <li><a href="#" data-section="statistics">Estadísticas</a></li>
          <li><a href="#" data-section="plugins">Plugins</a></li>
        </ul>
      </nav>
    </aside>

    <main class="main-content">
      <header class="dashboard-header">
        <h1>Panel de WordPress</h1>
        <p>Gestor de contenidos y análisis de rendimiento</p>
      </header>

      <!-- Sección Resumen -->
      <section id="overview" class="dashboard-section active">
        <h2>Resumen General</h2>
        <div class="summary-cards">
          <div class="summary-card" id="total-posts">
            <h3>Publicaciones</h3>
            <p class="summary-value">Cargando...</p>
          </div>
          <div class="summary-card" id="total-visitors">
            <h3>Visitantes</h3>
            <p class="summary-value">Cargando...</p>
          </div>
          <div class="summary-card" id="active-plugins">
            <h3>Plugins Activos</h3>
            <p class="summary-value">Cargando...</p>
          </div>
        </div>
      </section>

      <!-- Sección Estadísticas -->
      <section id="statistics" class="dashboard-section">
        <h2>Estadísticas de Contenido</h2>
        <div class="chart-container">
          <canvas id="contentChart"></canvas>
        </div>
      </section>

      <!-- Sección Plugins -->
      <section id="plugins" class="dashboard-section">
        <h2>Plugins Instalados</h2>
        <div class="resources-grid" id="plugins-grid"></div>
      </section>
    </main>
  </div>
</div>

<script>

    
document.addEventListener('DOMContentLoaded', async () => {
  // Configuración inicial
  const API_BASE = 'https://www.elsaltoweb.es/wp-json';
  const chartCanvas = document.getElementById('contentChart') as HTMLCanvasElement;
  let contentChart;

  // Navegación
  document.querySelectorAll('.sidebar a').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const section = (link as HTMLElement).dataset.section;
      document.querySelectorAll('.dashboard-section').forEach(s => s.classList.remove('active'));
      document.querySelectorAll('.sidebar li').forEach(li => li.classList.remove('active'));
      link.parentElement.classList.add('active');
      document.getElementById(section).classList.add('active');
    });
  });

  // Funciones de datos
  const fetchData = async (endpoint) => {
    try {
      const response = await fetch(`${API_BASE}${endpoint}`);
      if (!response.ok) throw new Error(`Error HTTP: ${response.status}`);
      return await response.json();
    } catch (error) {
      console.error(`Error fetching ${endpoint}:`, error);
      return null;
    }
  };

  // Actualizar tarjetas
  const updateCard = (id, value, isError = false) => {
    const card = document.getElementById(id);
    if (!card) return;

    card.classList.remove('loading', 'error');
    const valueElement = card.querySelector('.summary-value');
    
    if (isError) {
      card.classList.add('error');
      valueElement.textContent = 'Error';
    } else {
      valueElement.textContent = value;
    }
  };

  // Cargar datos iniciales
  const loadInitialData = async () => {
    // Publicaciones
    const posts = await fetchData('/wp/v2/posts?per_page=1');
    updateCard('total-posts', posts?.length ?? 'Error', !posts);

    // Plugins (requiere endpoint personalizado)
    const plugins = await fetchData('/custom/v1/plugins');
    updateCard('active-plugins', plugins?.length ?? 'Error', !plugins);
  };

  // Configurar gráfico
  const initChart = async () => {
    const categories = await fetchData('/wp/v2/categories');
    
    if (contentChart) contentChart.destroy();

    // Dynamic import of Chart.js on the client
    const ChartModule = await import('chart.js/auto');
    const Chart = ChartModule.default;

    contentChart = new Chart(chartCanvas, {
      type: 'bar',
      data: {
        labels: categories?.map(c => c.name) || [],
        datasets: [{
          label: 'Publicaciones por Categoría',
          data: categories?.map(c => c.count) || [],
          backgroundColor: 'rgba(186, 101, 115, 0.5)',
          borderColor: 'rgba(186, 101, 115, 1)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });
  };

  // Cargar plugins
  const loadPlugins = async () => {
    const plugins = await fetchData('/custom/v1/plugins');
    const grid = document.getElementById('plugins-grid');
    
    if (!plugins || !grid) return;
    
    grid.innerHTML = plugins.map(plugin => `
      <div class="plugin-card">
        <h3>${plugin.name}</h3>
        <p>Versión: ${plugin.version}</p>
        <p>${plugin.description}</p>
      </div>
    `).join('');
  };

  // Inicializar
  await loadInitialData();
  await initChart();
  await loadPlugins();
});
</script>
</Layout>