---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import NavBar from '../components/NavBar.astro';
---

<Layout title="Bienvenidos a ElSaltoWeb">
  <main class="container">
    <h1 class="hero-title">
      <span class="hero-gradient">ElSaltoWeb.es</span>
      <span class="subtitle">Tu puente entre WordPress y el Jamstack</span>
    </h1>
    
    <section class="intro-card">
      <div class="glow-effect"></div>
      <p class="intro-text">
        Conecta WordPress con cualquier frontend y crea experiencias personalizadas e innovadoras. 
        Utiliza React, Vue.js, Astro u otros frameworks para construir soluciones modernas y optimizadas.
      </p>
    </section>

    <ul class="card-grid">
      <Card
        href="https://developer.wordpress.org/rest-api/"
        title="API REST de WordPress"
        body="Aprende a usar la API REST de WordPress con Astro."/>
      <Card
        href="https://elsaltoweb.es/headless-cms/"
        title="Guía de Integración"
        body="Integra WordPress con Astro paso a paso."
      />
      <Card
        href="https://astro.build/integrations/"
        title="Integraciones con Astro"
        body="Mejora tu proyecto con integraciones."
      />

    </ul>
  </main>

<style is:global>
  :root {
    --gradient-1: #ff7e5f;
    --gradient-2: #feb47b;
    --gradient-3: #86a8e7;
    --gradient-4: #91eac9;
    --accent-gradient: linear-gradient(45deg, 
      var(--gradient-1),
      var(--gradient-2),
      var(--gradient-3),
      var(--gradient-4)
    );
    --glass-bg: rgba(255, 255, 255, 0.05);
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 70px 1rem;
    min-height: 100vh;
  }

  .hero-title {
    text-align: center;
    margin: 4rem 0 3rem;
    position: relative;
  }

  .hero-gradient {
    display: block;
    font-size: clamp(3rem, 8vw, 6rem);
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 400%;
    animation: gradientFlow 12s ease infinite;
    line-height: 1.1;
  }

  .subtitle {
    display: block;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: rgba(255, 255, 255, 0.85);
    margin-top: 1.5rem;
    font-weight: 300;
  }

  .intro-card {
    position: relative;
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    border-radius: 16px;
    padding: 2.5rem;
    margin: 3rem auto;
    max-width: 800px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transform: translateY(0);
    transition: transform 0.3s ease;
  }

  .intro-card:hover {
    transform: translateY(-5px);
  }

  .glow-effect {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: radial-gradient(
      800px circle at var(--x) var(--y),
      rgba(134, 168, 231, 0.15),
      transparent 40%
    );
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .intro-card:hover .glow-effect {
    opacity: 1;
  }

  .intro-text {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    padding: 2rem 0;
    margin: 0 auto;
    max-width: 1200px;
  }

  @keyframes gradientFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @media (max-width: 768px) {
    .container {
        margin-top: 80px;
      padding: 1rem;
    }
    
    .intro-card {
      padding: 1.5rem;
      margin: 2rem 0;
    }
    
    .card-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      margin: 2rem 0;
    }
    
    .intro-text {
      font-size: 1rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Animación con seguimiento del mouse para el efecto de brillo
  document.addEventListener('DOMContentLoaded', () => {
    const introCard = document.querySelector('.intro-card');
    
    if(introCard) {
      introCard.addEventListener('mousemove', (e) => {
        const rect = introCard.getBoundingClientRect();
        introCard.style.setProperty('--x', `${e.clientX - rect.left}px`);
        introCard.style.setProperty('--y', `${e.clientY - rect.top}px`);
      });
    }

    // Animaciones GSAP con ScrollTrigger
    gsap.from(".hero-gradient", {
      duration: 1.5,
      opacity: 0,
      y: 50,
      ease: "power4.out"
    });

    gsap.from(".subtitle", {
      duration: 1,
      opacity: 0,
      y: 30,
      delay: 0.3,
      ease: "expo.out"
    });

    gsap.from(".intro-card", {
      scrollTrigger: {
        trigger: ".intro-card",
        start: "top 80%"
      },
      duration: 1,
      opacity: 0,
      y: 50,
      ease: "power2.out"
    });

    gsap.from(".card-grid > *", {
      scrollTrigger: {
        trigger: ".card-grid",
        start: "top 90%"
      },
      duration: 0.8,
      opacity: 0,
      y: 40,
      stagger: 0.15,
      ease: "back.out(1.4)"
    });
  });
</script>